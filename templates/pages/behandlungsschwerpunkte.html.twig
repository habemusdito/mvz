<div class="container mt-0 px-4 md:px-0">


    <div class="max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl mt-5 xl:mt-20 px-4 relative mx-auto flex justify-end">
        <div class="w-full lg:w-2/3">
            {% set media = sulu_resolve_media('5', 'de') %}
            <img class="animate-rise opacity-50 xl:opacity-100 mask-l-from-50% mask-l-to-95% min-h-100 object-cover rounded-3xl" src="{{ media.url }}" alt="">
            <div class="absolute top-4 lg:top-10 xl:top-20 left-0 w-full">
                <div class="mx-auto max-w-screen-md lg:max-w-screen-xl py-2 px-4">
                    <div class="w-full xl:w-1/2 ps-4 lg:ps-0">
                        <h2 class="font-heading text-4xl md:text-7xl text-gray">Regenerative <span class="animate-rise bg-gradient-to-r from-third-700 to-third-400 bg-clip-text text-transparent">Mitochondrienmedizin</span></h2>
                        <p class="lg:w-2/3 mt-6 md:text-lg text-muted-foreground animate-rise [animation-delay:160ms]">bei erworbener mitochondrialer Dysfunktion</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl mt-5 xl:mt-20 px-4 relative mx-auto flex justify-start">
        <div class="w-full lg:w-2/3">
            {% set media = sulu_resolve_media('6', 'de') %}
            <img class="animate-rise opacity-50 xl:opacity-100 mask-r-from-50% mask-r-to-95% min-h-100 object-cover rounded-3xl" src="{{ media.url }}" alt="">
            <div class="absolute top-4 lg:top-10 xl:top-20 right-4 w-full">
                <div class="mx-auto max-w-screen-md lg:max-w-screen-xl py-2 px-4 flex justify-end">
                    <div class="w-full xl:w-1/2 ps-4 lg:ps-0">
                        <h2 class="font-heading text-4xl md:text-7xl text-gray">Vitalstoff<span class="animate-rise bg-gradient-to-r from-third-700 to-third-400 bg-clip-text text-transparent">beratung</span> und therapie</h2>
                        <p class="lg:w-2/3 mt-6 md:text-lg text-muted-foreground animate-rise [animation-delay:160ms]">Immer mehr Menschen sind auf eine optimierte Nährstoffversorgung angewiesen</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
