{% extends 'base.html.twig' %}

{% block meta %}
    <title>Blutentnahmetermin vereinbaren – MVZ Ganzimmun</title>
    <meta name="description" content="Vereinbaren Sie online einen Termin zur Blutentnahme im MVZ Ganzimmun.">
{% endblock %}

{% block content %}
    <div class="container mt-10 xl:mt-20 mb-20 px-4 md:px-0">
        <div class="border-b border-b-gray mb-8">
            <h1 class="font-heading text-gray-900 text-4xl px-4 pt-4 uppercase">Blutentnahmetermin vereinbaren</h1>
        </div>

        {% for message in app.flashes('blutentnahme_success') %}
            <div class="flex items-center p-4 mb-8 text-third-700 text-lg rounded-xl bg-third-100" role="alert">
                {{ ux_icon('tabler:circle-check', {class: 'w-8 h-8 me-4 shrink-0'}) }}
                <p>{{ message }}</p>
            </div>
        {% endfor %}
        {% for message in app.flashes('blutentnahme_error') %}
            <div class="flex items-center p-4 mb-8 text-rose-800 text-lg rounded-xl bg-rose-100" role="alert">
                {{ ux_icon('tabler:alert-circle', {class: 'w-8 h-8 me-4 shrink-0'}) }}
                <p>{{ message }}</p>
            </div>
        {% endfor %}

        <div class="grid grid-cols-12 gap-8"
             data-etermin
             data-days-url="{{ path('etermin_days') }}"
             data-slots-url="{{ path('etermin_slots', {date: '0000-00-00'}) }}"
             data-min-date="{{ minDate|date('Y-m-d', false) }}"
             data-max-date="{{ maxDate|date('Y-m-d', false) }}">
            <div class="col-span-12 md:col-span-7">
                <div class="bg-white/50 shadow-xl p-6 rounded-3xl">
                    <h2 class="font-heading text-2xl text-gray-900 mb-4">Tag auswählen</h2>
                    <div class="flex justify-center" data-etermin-calendar></div>
                    <p class="mt-4 text-sm text-gray-600" data-etermin-status>Freie Termine werden geladen …</p>
                </div>
            </div>
            <div class="col-span-12 md:col-span-5">
                <div class="bg-white/50 shadow-xl p-6 rounded-3xl" data-etermin-slots>
                    <h2 class="font-heading text-2xl text-gray-900 mb-4">Uhrzeit auswählen</h2>
                    <p class="text-gray-600">Bitte wählen Sie zuerst einen Tag im Kalender aus.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block importmap %}{{ importmap(['app', 'etermin']) }}{% endblock %}
