{% extends 'base.html.twig' %}

{% block content %}

    <div class="container mt-0 px-4 md:px-0">
        {% for schwerpunkt in content.pages %}
            <div class="max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl mt-5 xl:mt-20 relative mx-auto flex {{ loop.index is odd ? 'justify-end' : 'justify-start' }}">
                <div class="w-full lg:w-2/3">
                    {% set media = sulu_resolve_media(schwerpunkt.excerptImage, 'de') %}
                    <img class="animate-rise opacity-50 min-h-[250px] xl:opacity-100 {{ loop.index is odd ? 'md:mask-l-from-50% md:mask-l-to-95%' : 'md:mask-r-from-50% md:mask-r-to-85%' }}object-cover rounded-3xl" src="{{ media.url }}" alt="">
                    <div class="absolute top-4 left-0 w-full">
                        <div class="mx-auto max-w-screen-md lg:max-w-screen-xl py-2 px-4 {{ loop.index is even ? 'flex justify-end lg:text-end' }}">
                            <div class="w-full lg:w-2/3">
                                <twig:Highlight :text="schwerpunkt.excerptTitle" />
                                <p class="mt-6 md:text-lg text-muted-foreground animate-rise [animation-delay:160ms]">
                                    {{ schwerpunkt.excerptSubtitle }}</p>
                                <a href="{{ schwerpunkt.url }}" class="btn-white mb-2 mt-4">
                                    mehr Info
                                    {{ ux_icon('tabler:arrow-bar-right', {class: 'w-6 h-6 ms-4'}) }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

{% endblock %}
