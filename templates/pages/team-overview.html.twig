{% extends 'base.html.twig' %}

{% set arztteam   = content.pages|filter(p => p.excerptType == 'arzt') %}
{% set praxisteam = content.pages|filter(p => p.excerptType == 'praxis') %}

{% block content %}
    <div class="max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl mt-5 xl:mt-20 px-4 relative mx-auto">
        <img class="animate-rise opacity-80 xl:opacity-100 mask-l-from-50% mask-l-to-95% min-h-100 object-cover rounded-3xl" src="{{ asset('layoutimages/vorsorge.jpg') }}">
        <div class="absolute top-4 lg:top-10 xl:top-20 left-0 w-full">
            <div class="mx-auto max-w-screen-md lg:max-w-screen-xl py-2 px-4">
                <div class="w-full xl:w-1/2 ps-4 lg:ps-0">
                    <h1 class="eyebrow animate-rise text-third mb-3">{{ content.header_title }}</h1>
                    <twig:Highlight :text="content.header_subtitle" />
                    <p class="lg:w-2/3 mt-6 md:text-lg text-muted-foreground animate-rise [animation-delay:160ms]">{{ content.header_description }}</p>
                </div>
            </div>
        </div>
        {% include 'includes/allcontact.html.twig' %}
    </div>

    {% if arztteam is not empty %}
        <div class="container mt-20 md:mt-32">
            <div class="border-b border-b-gray mb-12">
                <h2 class="font-heading text-gray-900 text-4xl px-4 pt-4 uppercase">Arzt-Team</h2>
            </div>
            <div class="flex flex-wrap justify-center gap-12">
                {% for arzt in arztteam %}
                    <div class="w-full md:w-[calc((100%-6rem)/3)]">
                        <div class="relative bg-third-50 p-6 border border-third-300 rounded-xl shadow-xl">
                            <div class="flex flex-col items-center">
                                <img class="w-1/2 h-1/2 mb-6 rounded-full" src="{{ arzt.excerptImage.formats['sulu-260x'] }}" alt="{{ arzt.excerptTitle }}"/>
                                <h3 class="font-heading text-lg mb-3">{{ arzt.excerptTitle }}</h3>
                                <span class="text-sm text-body">{{ arzt.excerptDescription }}</span>
                                <div class="flex mt-4 md:mt-6 gap-4">
                                    <a href="{{ arzt.url }}" class="btn-third">
                                        mehr Info
                                        {{ ux_icon('tabler:arrow-bar-right', {class: 'w-6 h-6 ms-4'}) }}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if praxisteam is not empty %}
        <div class="container mt-20 md:mt-32">
            <div class="border-b border-b-gray mb-12">
                <h2 class="font-heading text-gray-900 text-4xl px-4 pt-4 uppercase">Praxis-Team</h2>
            </div>
            <div class="flex flex-wrap justify-center gap-12">
                {% for member in praxisteam %}
                    <div class="w-full md:w-[calc((100%-6rem)/3)]">
                        <div class="relative bg-third-50 p-6 border border-third-300 rounded-xl shadow-xl">
                            <div class="flex flex-col items-center">
                                <img class="w-1/2 h-1/2 mb-6 rounded-full" src="{{ member.excerptImage.formats['sulu-260x'] }}" alt="{{ member.excerptTitle }}"/>
                                <h3 class="font-heading text-lg mb-3">{{ member.excerptTitle }}</h3>
                                <span class="text-sm text-body">{{ member.excerptDescription }}</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
