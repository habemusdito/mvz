{% extends 'base.html.twig' %}

{% block content %}
    {% if content.url is same as '/sprechzeiten' %}
        {% include 'pages/sprechzeiten.html.twig' %}
    {% else %}

        {% set hasHeaderText = content.header_title or content.header_subtitle or content.header_description %}
        {% if hasHeaderText or content.header_image or content.header_more_description %}
            <div class="max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl mt-5 xl:mt-20 px-4 relative mx-auto">
                <twig:Image :image="content.header_image" />
                {% if hasHeaderText %}
                    <div class="absolute top-4 lg:top-10 xl:top-20 left-0 w-full">
                        <div class="mx-auto max-w-screen-md lg:max-w-screen-xl py-2 px-4">
                            <div class="w-full xl:w-1/2 ps-4 lg:ps-0">
                                <twig:Text tag="h1" class="eyebrow animate-rise text-third mb-3" :value="content.title" />
                                <twig:Highlight :text="content.header_subtitle" />
                                <twig:Text class="lg:w-2/3 mt-6 md:text-lg text-muted-foreground animate-rise [animation-delay:160ms]" :value="content.header_description" />
                            </div>
                        </div>
                    </div>
                {% endif %}
                <twig:RichText :value="content.header_more_description" />
            </div>
        {% endif %}

        {% if content.sections %}
            <div class="grid grid-cols-3 max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl mt-5 xl:mt-20 px-4 pt-4 relative mx-auto border-t border-t-gray-900">
                {% for section in content.sections %}
                    <div class="col-span-{{ section.header_image ? '2' : '3' }}">
                        <twig:Text tag="h1" class="eyebrow animate-rise text-third" :value="section.header_title" />
                        <twig:Highlight :text="section.header_subtitle" />
                        <twig:Text class="text-muted-foreground animate-rise [animation-delay:160ms] mt-4" :value="section.header_description" />
                    </div>
                    <twig:Image :image="section.header_image" class="col-span-1 self-start animate-rise opacity-50 xl:opacity-100 lg:mask-l-from-50% lg:mask-l-to-95% min-h-100 object-cover rounded-3xl" />
                    <twig:Quote :quote="section.quote" :author="section.author" class="col-span-3 mt-4 px-4 pt-4 pb-8 border-b border-b-gray-900" />
                    <twig:RichText :value="section.header_more_description" class="col-span-3 list-more-description mt-4" />
                {% endfor %}
                <div class="col-span-3 border-t border-t-gray-900 pt-4 mt-10">
                    {% include 'includes/allcontact.html.twig' %}
                </div>
            </div>
        {% endif %}
    {% endif %}


{% endblock %}
