        <div class="grid grid-cols-3 max-w-screen-md lg:max-w-screen-lg xl:max-w-screen-xl mt-5 xl:mt-20 p-0 relative mx-auto bg-third-100 rounded-3xl">
            <div class="col-span-2 p-10">
